{
    "name": "industrialdev/wicket-admin-org-roster",
    "description": "WordPress admin plugin for managing organization rosters and person-to-organization relationships via the Wicket MDP API.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "Wicket Inc.",
            "homepage": "https://wicket.io"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:industrialdev/wicket-lib-org-roster.git"
        }
    ],
    "require": {
        "php": ">=8.2",
        "industrialdev/wicket-lib-org-roster": "^0.9.1",
        "woocommerce/action-scheduler": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "WicketAORM\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
